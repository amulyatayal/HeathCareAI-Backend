# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# OpenSearch Configuration (Managed Cluster)
OPENSEARCH_ENDPOINT=your-opensearch-endpoint.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=breast_cancer_knowledge
OPENSEARCH_USERNAME=opensearch_admin
OPENSEARCH_PASSWORD=your_opensearch_password

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# S3 Configuration (for document storage)
S3_BUCKET_NAME=healthcare-ai-documents
S3_REGION=us-east-1

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Admin Portal
ADMIN_JWT_SECRET=change-me-in-production-use-a-real-secret
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRY_HOURS=24

# CORS (comma-separated origins for iOS/Android/Web)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Knowledge Base
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_EMBEDDING_DIMENSION=1024

# Chat: guests never require OAuth. Optional X-User-ID for session tracking.
# Set to N only so fully anonymous requests (no Bearer, no X-User-ID) get a synthetic test user id
IS_AUTHENTICATION_REQUIRED=Y
UNAUTHENTICATED_TEST_USER_ID=anonymous_test

